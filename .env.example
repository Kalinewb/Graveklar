# Database (SQLite)
DATABASE_URL="file:./prisma/prisma/db/custom.db"

# Admin login — change this on first run
# The app will force a password change if this is still "admin"
ADMIN_PASSWORD=admin

# Session signing secret (defaults to ADMIN_PASSWORD if unset)
# Generate one with: openssl rand -hex 32
# ADMIN_SESSION_SECRET=

# Bearer secret the scheduled jobs present to /api/cron/cleanup and
# /api/cron/reminders (see DEPLOYMENT.md §6). Required in production.
# Generate one with: openssl rand -hex 32
# CRON_SECRET=

# Signs the renter QR-checklist session (4 h). Defaults to ADMIN_SESSION_SECRET
# when unset; set it separately if you rotate admin secrets independently.
# RENTER_SESSION_SECRET=

# All other settings (business info, SMTP, Stripe, pricing, booking rules)
# are configured from the Admin panel — no env vars needed.
